# Committed defaults for local development. Real secrets go in .env.local or the
# environment, never here.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-env-local
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> order-hub ###
# The marketplace simulator (apps/marketplace).
MARKETPLACE_BASE_URL=http://127.0.0.1:8100
NOVA_API_KEY=nova-demo-key
NOVA_WEBHOOK_SECRET=nova-demo-webhook-secret
ATLAS_API_KEY=atlas-demo-key
# Empty: the incident analyst uses its rule engine. Set it to use Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Retention: journal entries, and webhook event ids kept for deduplication.
JOURNAL_RETENTION_DAYS=30
WEBHOOK_EVENT_RETENTION_DAYS=7
# Model analyses allowed per day; beyond, the rule engine answers.
MODEL_DAILY_ANALYSES=50
# Service token the console sends to /api/*. Empty refuses every call: set a
# long random value (.env.dev holds the one for local development).
HUB_API_TOKEN=
###< order-hub ###
