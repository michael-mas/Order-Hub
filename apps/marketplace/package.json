{
  "name": "@order-hub/marketplace",
  "private": true,
  "type": "module",
  "description": "An unruly marketplace simulator: quotas, faults, duplicated and out-of-order signed webhooks",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
